package arrays;

public class Ejemplo1 {
	public static void main (String[]args) {
		
		int[]numeros = {3, 2, 7, 9};
		System.out.println("Tamaño: " + numeros.length);
		System.out.println("Primer elemento: " + numeros[0]);
		System.out.println("Segundo elemento: " + numeros[1]);
		System.out.println("Último elemento: " + numeros[numeros.length-1]); //hace esto para acceder al último elemento porque si se modifica el array va a darte el 2º)		
		// Cambia el valor a 7 de la posición primera (0)
		numeros[0]=7;
		System.out.println("Primer elemento cambiando el valor: " + numeros[0]);
		// Duplica el valor de la posición primera (0)
		numeros[0] = numeros[0] * 2;
		System.out.println("Primer elemento multiplicado por 2: " + numeros[0]);
		
		//Crear array de enteros con números del 1 al 4
		int[]enteros = {1,2,3,4};
		//Duplicar cada elemento del array
		numeros [0] = numeros [0] * 2;
		numeros [1] = numeros [1] * 2;
		numeros [2] = numeros [2] * 2;
		numeros [3] = numeros [3] * 2;
		//Mostrar cada elemento del array
		
		for (int i = 0; i<=numeros[3] ;++i) {
			System.out.printf("%d ",i);
		}
		
		
	}
}
